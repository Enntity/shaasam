# Copy to /opt/shaasam/.env with mode 600. Never commit actual credentials.
DOMAIN=shaasam.example.com
SITE_URL=https://shaasam.example.com
ACME_EMAIL=you@example.com
GITHUB_REPOSITORY=enntity/shaasam
# The deployment workflow persists IMAGE_DIGEST separately in .release.env.
MONGODB_URI=mongodb+srv://user:password@cluster.example/shaasam
MONGODB_DB=shaasam
AUTH_SECRET=
# Stable independent agent identities; single quotes preserve JSON in Compose.
SHAASAM_AGENT_KEYS='{"initial-agent":"replace-with-an-independent-random-secret-at-least-32-characters"}'
SHAASAM_ADMIN_KEY=
SHAASAM_PLATFORM_FEE_BPS=0
REQUIRE_REVIEW=true
# Set true only after confirming direct access is blocked and Traefik overwrites X-Real-IP.
TRUST_PROXY=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TRAEFIK_DASHBOARD_AUTH=
