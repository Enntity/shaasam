MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=shaasam
AUTH_SECRET=
SITE_URL=http://localhost:3000
# Local compatibility key. Production uses the stable agent-ID map below.
SHAASAM_API_KEY=
# JSON object: {"agent-id":"random-secret-at-least-32-characters"}; rotate value, retain ID.
SHAASAM_AGENT_KEYS=
SHAASAM_ADMIN_KEY=
SHAASAM_PLATFORM_FEE_BPS=0
REQUIRE_REVIEW=true
# Set true ONLY behind a trusted reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
